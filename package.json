{
  "name": "kubernetes-docs-roadmap",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "validate:print": "tsx scripts/validate.ts --print",
    "l10n": "tsx scripts/fetch-l10n.ts",
    "watch:upstream": "tsx scripts/watch-upstream.ts",
    "propose": "tsx scripts/propose-nodes.ts",
